{
  "name": "@npm-telluria-tecnologia/telluria-ui",
  "description": "Common react components for application development",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist",
  "license": "MIT",
  "author": "Telluria Tecnologia",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/t3105/telluria-ui.git"
  },
  "keywords": [
    "utils",
    "telluria",
    "react",
    "components",
    "telluria-ui",
    "TS"
  ],
  "scripts": {
    "test": "react-scripts test --watchAll=false --coverage",
    "build": "rollup -c",
    "start": "rollup -c -w",
    "commit": "git-cz",
    "pubnpm": "yarn build && yarn publish --no-git-tag-version",
    "lint-check": "eslint src --ext js,ts,tsx",
    "lint-fix": "eslint src --fix --ext js,ts,tsx",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@storybook/addon-docs": "9.0.8",
    "@storybook/addon-webpack5-compiler-swc": "3.0.0",
    "@testing-library/user-event": "^7.1.2",
    "@types/datatables.net": "^1.10.19",
    "@types/datatables.net-select": "^1.2.6",
    "@types/jquery": "^3.5.8",
    "@types/lodash": "^4.14.191",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "@types/react-html-parser": "^2.0.2",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "commitizen": "^4.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^8.0.0",
    "eslint-config-airbnb": "^18.2.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-storybook": "9.0.8",
    "husky": "^7.0.2",
    "lint-staged": "^11.2.3",
    "prop-types": "15.8.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "rollup": "^2.58.0",
    "rollup-plugin-typescript2": "^0.30.0",
    "storybook": "9.0.8",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.2.5",
    "@mui/lab": "^5.0.0-alpha.77",
    "@mui/material": "^5.2.7",
    "@storybook/react-webpack5": "9.0.8",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/react-hooks": "^7.0.2",
    "@unform/core": "^2.1.6",
    "@unform/web": "^2.1.6",
    "datatables-epresponsive": "^0.0.3",
    "datatables.net": "^1.10.23",
    "datatables.net-buttons": "^2.0.1",
    "datatables.net-buttons-dt": "^2.0.1",
    "datatables.net-dt": "^1.10.23",
    "datatables.net-responsive": "^2.2.7",
    "datatables.net-responsive-dt": "^2.2.7",
    "datatables.responsive.typings": "^1.0.3",
    "i18next": "^25.3.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "jotai": "^1.6.0",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "react-html-parser": "^2.0.2",
    "react-i18next": "^15.6.0",
    "react-icons": "^3.11.0",
    "react-scripts": "3.4.4",
    "react-spring": "^8.0.27",
    "react-svg": "^14.1.11",
    "styled-components": "^5.3.6",
    "uuid": "^8.3.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "yarn lint-fix",
      "yarn lint-check"
    ]
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "engines": {
    "node": ">= 10"
  },
  "browserslist": [
    "defaults"
  ]
}
